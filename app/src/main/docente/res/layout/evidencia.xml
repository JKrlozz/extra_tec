<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:text="Subir evidencia" />
        <TextView
            android:id="@+id/tvSubtitulo"
            style="@style/Itsm.Text.Secondary"
            android:textColor="#B8C4DA"
            android:text="" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Itsm.Content">

            <TextView
                style="@style/Itsm.Text.Section"
                android:layout_marginTop="0dp"
                android:text="Actividad" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Itsm.Card"
                android:layout_marginBottom="16dp">
                <Spinner
                    android:id="@+id/spinnerActividad"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Descripción">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnElegirFoto"
                style="@style/Itsm.Button.Secondary"
                android:text="Seleccionar fotografía" />
            <ImageView
                android:id="@+id/ivVistaPrevia"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:contentDescription="Vista previa de la fotografía"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEvidencia"
                style="@style/Itsm.Button.Primary"
                android:layout_marginTop="8dp"
                android:text="Guardar evidencia" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_docente" />
</LinearLayout>

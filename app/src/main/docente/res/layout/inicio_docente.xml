<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buen día," />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prof. Carlos Pérez" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:text="Mis clases" android:textStyle="bold" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fútbol - Lun. y Mié. 16:00 - 25 alumnos" />
            <Button android:id="@+id/btnPaseLista" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pase de lista" />
            <Button android:id="@+id/btnVerAlumnos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ver alumnos" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Baloncesto - Viernes 17:00 - 18 alumnos" />
            <Button android:id="@+id/btnPaseLista2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pase de lista" />
            <Button android:id="@+id/btnCerrarSesion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cerrar sesión" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_docente" />
</LinearLayout>

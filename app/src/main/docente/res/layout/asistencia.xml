<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:text="Pase de lista" />
        <TextView
            android:id="@+id/tvSubtitulo"
            style="@style/Itsm.Text.Secondary"
            android:textColor="#B8C4DA"
            android:text="" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Itsm.Content">

            <com.google.android.material.card.MaterialCardView style="@style/Itsm.Card">
                <LinearLayout
                    android:id="@+id/listaContenido"
                    style="@style/Itsm.CardBody"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/tvVacio"
                style="@style/Itsm.Text.Secondary"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarAsistencia"
                style="@style/Itsm.Button.Primary"
                android:text="Guardar asistencia" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginTop="8dp"
                android:text="Cancelar" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_docente" />
</LinearLayout>

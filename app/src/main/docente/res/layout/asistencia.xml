<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:text="Pase de lista" />
        <TextView
            style="@style/Itsm.Text.Secondary"
            android:textColor="#B8C4DA"
            android:text="Fútbol · Miércoles" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout style="@style/Itsm.Content">

            <com.google.android.material.card.MaterialCardView style="@style/Itsm.Card">
                <LinearLayout
                    style="@style/Itsm.CardBody"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <CheckBox
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/itsm_primary"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="María Hernández · Matrícula 2024021"
                        android:textColor="@color/itsm_text" />

                    <CheckBox
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/itsm_primary"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="José Martínez · Matrícula 2024022"
                        android:textColor="@color/itsm_text" />

                    <CheckBox
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/itsm_primary"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="Diana Sánchez · Matrícula 2024023"
                        android:textColor="@color/itsm_text" />

                    <CheckBox
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/itsm_primary"
                        android:minHeight="48dp"
                        android:text="Pedro García · Matrícula 2024024"
                        android:textColor="@color/itsm_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarAsistencia"
                style="@style/Itsm.Button.Primary"
                android:text="Guardar asistencia" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginTop="8dp"
                android:text="Cancelar" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_docente" />
</LinearLayout>

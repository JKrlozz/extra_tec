<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:text="Bienvenido," />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:layout_marginTop="0dp"
            android:text="Administrador" />
        <TextView
            style="@style/Itsm.Text.Secondary"
            android:textColor="#B8C4DA"
            android:text="Panel de gestión institucional" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout style="@style/Itsm.Content">

            <TextView
                style="@style/Itsm.Text.Section"
                android:text="Accesos rápidos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrActividades"
                style="@style/Itsm.Button.Primary"
                android:layout_marginBottom="10dp"
                android:text="Actividades" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrDocentes"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginBottom="10dp"
                android:text="Docentes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrAlumnos"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginBottom="10dp"
                android:text="Alumnos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrReportes"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginBottom="10dp"
                android:text="Reportes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Itsm.Button.Text"
                android:layout_marginTop="12dp"
                android:text="Cerrar sesión" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_admin" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bienvenido," />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Administrador" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:text="Accesos rápidos" android:textStyle="bold" />

            <Button android:id="@+id/btnIrActividades" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Actividades" />
            <Button android:id="@+id/btnIrDocentes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Docentes" />
            <Button android:id="@+id/btnIrAlumnos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Alumnos" />
            <Button android:id="@+id/btnIrReportes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reportes" />
            <Button android:id="@+id/btnCerrarSesion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cerrar sesión" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_admin" />
</LinearLayout>

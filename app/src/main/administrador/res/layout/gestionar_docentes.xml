<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Docentes" android:textSize="20sp" android:textStyle="bold" />
            <Button android:id="@+id/btnTabAlumnos" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ver alumnos" />
            <Button android:id="@+id/btnNuevoDocente" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Nuevo docente" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Carlos Pérez - Especialidad extracurricular" />
            <Button android:id="@+id/btnEditarDocente" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editar" />
            <Button android:id="@+id/btnEliminarDocente" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Eliminar" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ana López - Especialidad extracurricular" />
            <Button android:id="@+id/btnEditarDocente2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editar" />
            <Button android:id="@+id/btnEliminarDocente2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Eliminar" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_admin" />
</LinearLayout>

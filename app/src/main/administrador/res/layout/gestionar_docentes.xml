<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:text="Docentes" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Itsm.Content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabAlumnos"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginBottom="12dp"
                android:text="Ver alumnos" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Buscar docente">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevoDocente"
                style="@style/Itsm.Button.Primary"
                android:layout_marginBottom="16dp"
                android:text="+ Nuevo docente" />
            <LinearLayout
                android:id="@+id/listaContenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView
                android:id="@+id/tvVacio"
                style="@style/Itsm.Text.Secondary"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_admin" />
</LinearLayout>

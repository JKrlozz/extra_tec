<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Actividades" android:textSize="20sp" android:textStyle="bold" />
            <Button android:id="@+id/btnNuevaActividad" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Nueva actividad" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Fútbol - Lun. y Mié. 16:00 - Cupo 18/25" />
            <Button android:id="@+id/btnEditarActividad" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editar" />
            <Button android:id="@+id/btnEliminarActividad" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Eliminar" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ajedrez - Martes 15:00 - Cupo 12/20" />
            <Button android:id="@+id/btnEditarActividad2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Editar" />
            <Button android:id="@+id/btnEliminarActividad2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Eliminar" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_admin" />
</LinearLayout>

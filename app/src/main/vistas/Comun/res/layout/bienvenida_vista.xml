<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/itsm_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_lateral"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/margen_lateral"
        android:paddingBottom="32dp">

        <!-- circulo verde con el nombre -->
        <TextView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/fondo_circulo"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="ITSM"
            android:textColor="@color/itsm_primary_dark"
            android:textSize="44sp"
            android:textStyle="bold" />

        <View
            android:layout_width="64dp"
            android:layout_height="3dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:background="@color/itsm_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Actividades Extraescolares"
            android:textColor="@color/itsm_primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Instituto Tecnológico Superior de Misantla"
            android:textColor="@color/itsm_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntrar"
            style="@style/Itsm.Button.Primary"
            android:layout_marginTop="48dp"
            android:minHeight="52dp"
            android:text="Entrar"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>

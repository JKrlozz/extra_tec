<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/contenedorVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/itsm_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_lateral"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/margen_lateral"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtras"
            style="@style/Itsm.Button.Volver"
            android:text="Volver"
            app:icon="@drawable/ic_volver" />
    </LinearLayout>

    <include
        android:id="@+id/barraAlumno"
        layout="@layout/barra_alumno_vista"
        android:visibility="gone" />

    <include
        android:id="@+id/barraDocente"
        layout="@layout/barra_docente_vista"
        android:visibility="gone" />

    <include
        android:id="@+id/barraAdmin"
        layout="@layout/barra_admin_vista"
        android:visibility="gone" />
</LinearLayout>

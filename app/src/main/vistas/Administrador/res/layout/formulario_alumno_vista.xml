<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            android:id="@+id/tvTituloForm"
            style="@style/Itsm.HeaderTitle"
            android:text="Agregar alumno" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            style="@style/Itsm.Content">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Nombre(s)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombres"
                    android:maxLength="50"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Apellido paterno">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidoPaterno"
                    android:maxLength="40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Apellido materno">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApellidoMaterno"
                    android:maxLength="40"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Correo"
                app:helperText="Usa tu número de control, por ejemplo 193t0183@itsm.edu.mx">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    android:maxLength="100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Número de control"
                app:helperText="Formato 000T0000, por ejemplo 232T0182">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMatricula"
                    android:digits="0123456789Tt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:maxLength="8" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                style="@style/Itsm.Text.Section"
                android:layout_marginTop="0dp"
                android:text="Carrera" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Itsm.Card"
                android:layout_marginBottom="16dp">
                <Spinner
                    android:id="@+id/spinnerCarrera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/Itsm.Text.Section"
                android:layout_marginTop="0dp"
                android:text="Semestre" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Itsm.Card"
                android:layout_marginBottom="16dp">
                <Spinner
                    android:id="@+id/spinnerSemestre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:id="@+id/grupoActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    style="@style/Itsm.Text.Section"
                    android:layout_marginTop="0dp"
                    android:text="Actividad extraescolar" />
                <com.google.android.material.card.MaterialCardView
                    style="@style/Itsm.Card"
                    android:layout_marginBottom="16dp">
                    <Spinner
                        android:id="@+id/spinnerActividad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContrasena"
                style="@style/Itsm.Field"
                android:hint="Contraseña inicial"
                app:helperText="Opcional. De 8 a 30 caracteres. Si la dejas vacía se genera una"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContrasena"
                    android:maxLength="30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Itsm.Button.Primary"
                android:layout_marginTop="8dp"
                android:text="Guardar" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginTop="8dp"
                android:text="Cancelar" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

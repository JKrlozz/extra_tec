<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:text="Reportes" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Itsm.Content">

            <TextView
                style="@style/Itsm.Text.Section"
                android:text="Tipo de reporte" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Itsm.Card"
                android:layout_marginBottom="16dp">
                <Spinner
                    android:id="@+id/spinnerTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- filtros que cambian segun el tipo -->
            <LinearLayout
                android:id="@+id/grupoFiltros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Itsm.Text.Section"
                    android:text="Filtros" />

                <TextView
                    android:id="@+id/tvAyudaFiltros"
                    style="@style/Itsm.Text.Secondary"
                    android:layout_marginBottom="8dp"
                    android:text="Todos son opcionales. Con número de control o nombre se muestra el detalle por sesión." />

                <LinearLayout
                    android:id="@+id/grupoFiltrosAlumno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Itsm.Field"
                        android:hint="Número de control">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMatriculaReporte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLength="8" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Itsm.Field"
                        android:hint="Nombre del alumno">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreReporte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:maxLength="100" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Itsm.Card"
                        android:layout_marginBottom="8dp">
                        <Spinner
                            android:id="@+id/spinnerCarreraReporte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Itsm.Card"
                        android:layout_marginBottom="8dp">
                        <Spinner
                            android:id="@+id/spinnerSemestreReporte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDocenteReporte"
                    style="@style/Itsm.Field"
                    android:hint="Nombre o correo del docente">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDocenteReporte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="100" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Itsm.Card"
                    android:layout_marginBottom="16dp">
                    <Spinner
                        android:id="@+id/spinnerActividadReporte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/Itsm.Text.Section"
                android:text="Periodo" />

            <TextView
                style="@style/Itsm.Text.Secondary"
                android:layout_marginBottom="8dp"
                android:text="Puedes limitar el periodo con las fechas. Si las dejas vacías se usa todo el historial. Para un solo día usa la misma fecha en ambas." />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDesde"
                style="@style/Itsm.Field"
                android:hint="Fecha inicial"
                app:endIconDrawable="@drawable/ic_calendario"
                app:endIconMode="custom">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDesde"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHasta"
                style="@style/Itsm.Field"
                android:hint="Fecha final"
                app:endIconDrawable="@drawable/ic_calendario"
                app:endIconMode="custom">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHasta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLimpiarFechas"
                style="@style/Itsm.Button.Text"
                android:layout_marginBottom="8dp"
                android:text="Limpiar fechas" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerarReporte"
                style="@style/Itsm.Button.Primary"
                android:text="Generar reporte" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportarPdf"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginTop="8dp"
                android:text="Exportar PDF" />
            <LinearLayout
                android:id="@+id/encabezadoReporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTituloReporte"
                    style="@style/Itsm.Text.Title"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvResumenReporte"
                    style="@style/Itsm.Text.Secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVacioReporte"
                style="@style/Itsm.Text.Secondary"
                android:layout_marginTop="12dp"
                android:text="Genera un reporte para ver los resultados." />

            <LinearLayout
                android:id="@+id/listaReporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            style="@style/Itsm.HeaderTitle"
            android:text="Personas" />
        <TextView
            style="@style/Itsm.Text.Secondary"
            android:textColor="#E8C9D4"
            android:text="Alumnos y docentes del programa" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout style="@style/Itsm.Content">

            <com.google.android.material.card.MaterialCardView style="@style/Itsm.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalAlumnos"
                            style="@style/Itsm.Text.Metric"
                            android:text="0" />

                        <TextView
                            style="@style/Itsm.Text.Secondary"
                            android:text="Alumnos" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:background="@color/itsm_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTotalDocentes"
                            style="@style/Itsm.Text.Metric"
                            android:text="0" />

                        <TextView
                            style="@style/Itsm.Text.Secondary"
                            android:text="Docentes" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Itsm.Text.Section"
                android:text="Consultar" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabAlumnos"
                    style="@style/Itsm.Button.Tab"
                    android:layout_marginEnd="4dp"
                    android:text="Alumnos" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabDocentes"
                    style="@style/Itsm.Button.Tab"
                    android:layout_marginStart="4dp"
                    android:text="Docentes" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBuscar"
                style="@style/Itsm.Field"
                android:hint="Buscar por nombre o número de control">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNuevo"
                style="@style/Itsm.Button.Primary"
                android:layout_marginBottom="16dp"
                android:text="Nuevo alumno" />

            <LinearLayout
                android:id="@+id/listaContenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvVacio"
                style="@style/Itsm.Text.Secondary"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

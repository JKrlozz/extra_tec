<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Screen">

    <LinearLayout style="@style/Itsm.Header">
        <TextView style="@style/Itsm.HeaderOverline" />
        <TextView
            android:id="@+id/tvTitulo"
            style="@style/Itsm.HeaderTitle"
            android:text="Subir evidencia" />
        <TextView
            android:id="@+id/tvSubtitulo"
            style="@style/Itsm.HeaderSub"
            android:text="" />
    </LinearLayout>
    <View style="@style/Itsm.AccentBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            style="@style/Itsm.Content">

            <TextView
                style="@style/Itsm.Text.Section"
                android:layout_marginTop="0dp"
                android:text="Actividad" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Itsm.Card"
                android:layout_marginBottom="16dp">
                <Spinner
                    android:id="@+id/spinnerActividad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Itsm.Text.Section"
                android:text="Fecha de la actividad" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFecha"
                style="@style/Itsm.Button.Secondary"
                android:layout_marginBottom="16dp"
                android:text="Fecha"
                app:icon="@drawable/ic_calendario"
                app:iconTint="@color/itsm_primary" />

            <TextView
                style="@style/Itsm.Text.Section"
                android:text="Estado de la actividad" />
            <com.google.android.material.card.MaterialCardView
                style="@style/Itsm.Card"
                android:layout_marginBottom="16dp">
                <Spinner
                    android:id="@+id/spinnerEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Itsm.Field"
                android:hint="Descripción"
                app:helperText="Opcional"
                app:counterEnabled="true"
                app:counterMaxLength="300">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:maxLength="300"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Itsm.Text.Section"
                android:text="Fotografías" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnElegirFotos"
                    style="@style/Itsm.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Galería" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTomarFoto"
                    style="@style/Itsm.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Tomar foto" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvSinFotos"
                style="@style/Itsm.Text.Secondary"
                android:layout_marginTop="8dp"
                android:text="Sin fotografías. Para una actividad realizada debes agregar al menos una."
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/listaFotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarEvidencia"
                style="@style/Itsm.Button.Primary"
                android:layout_marginTop="16dp"
                android:text="Guardar evidencia" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHoraInicio"
            style="@style/Itsm.Text.Body"
            android:textColor="@color/itsm_primary_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHoraFin"
            style="@style/Itsm.Text.Secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:minHeight="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        android:background="@color/itsm_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActividad"
            style="@style/Itsm.Text.Body"
            android:textColor="@color/itsm_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLugar"
            style="@style/Itsm.Text.Secondary" />
    </LinearLayout>
</LinearLayout>

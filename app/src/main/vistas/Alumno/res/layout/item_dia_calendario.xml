<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Itsm.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDia"
                style="@style/Itsm.Text.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvEtiquetaHoy"
                style="@style/Itsm.Text.Secondary"
                android:layout_marginTop="0dp"
                android:text="Hoy"
                android:textColor="@color/itsm_accent"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorBloques"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvSinClases"
            style="@style/Itsm.Text.Secondary"
            android:layout_marginTop="6dp"
            android:text="Sin actividad" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
